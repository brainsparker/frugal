{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.brainsparker/frugal",
  "title": "Frugal",
  "description": "The open routing layer for AI tools: tool calls routed per policy, decision on every result.",
  "repository": {
    "url": "https://github.com/brainsparker/frugal",
    "source": "github"
  },
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "frugal-mcp",
      "version": "0.0.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
